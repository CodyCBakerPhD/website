% Rubrics (sections): an uppercase, letterspaced heading over a hairline, with
% a short teal bar at its start like the section headings of the website.
\headerscale{1}
\rubricfont{\large\bfseries\sffamily}
\setlength{\rubricspace}{3pt}
\setlength{\rubricafterspace}{2pt}
\setlength{\subrubricspace}{2pt}
\setlength{\subrubricbeforespace}{19pt}  % The height of a strut, so only what exceeds a line's own height shows
\continuedname{\ {\mdseries\small\color{CVMuted}(continued)}}

\def\@@rubrichead#1{%
  \begin{tikzpicture}[baseline]%
  \fill[CVRule] (0,0) rectangle (\@almosttextwidth,0.6pt);
  \fill[left color=CVAccent,right color=CVAccentLight,rounded corners=0.6pt] (0,-0.5pt) rectangle (1.5cm,1.6pt);
  \node[font={\@rubricfont},text=CVInk,inner sep=0pt,text ragged,anchor=south west,text depth=.5ex,text height=1.5ex] at (0pt,4pt) {#1};
  \end{tikzpicture}%
  \vspace\rubricspace%
}

% The title of a rubric: its icon in the accent color, then its name in
% letterspaced capitals.
\newcommand{\cvrubric}[2]{{\color{CVAccent}#1}\hspace{0.6em}\textls[60]{\MakeUppercase{#2}}}

\subrubricfont{\normalsize\bfseries\sffamily\color{CVAccentDark}}
\subrubricalignment{l}

\newcommand{\makefield}[2]{\makebox[1.5em]{\color{CVAccent}#1} #2\hspace{2em}}

\keyalignment{r}
\keyfont{\sffamily\small\color{CVMuted}}
\rubricalignment{l}
\renewcommand{\arraystretch}{1.25}
\urlstyle{tt}

% Gives the key column (dates, skill areas) a fixed width, so that the entries
% of every rubric start at the same place. Without it, each rubric's key column
% is as wide as its widest key.
\newlength{\cvkeywidth}
\newcommand{\fixedkeywidth}[1]{%
  \setlength{\cvkeywidth}{#1}%
  % \leavevmode first: a color change before any text would hang the key a line below its entry.
  \newcolumntype{k}{>{\raggedleft\arraybackslash\leavevmode\@keyfont}p{\cvkeywidth}}%
}

% The marker before each entry: none, as the bold title and the key column
% already set each entry apart. Pass one to \prefixmarker to bring it back.
\newcommand{\prefixmarker}[1]{\def\@prefixmarker{#1}}
\def\@prefixmarker{}

\prefix{\@prefixmarker}

\newcommand{\makerubrichead}[1]{\vskip\baselineskip\@@rubrichead{#1}}

% Starts a short rubric on the next page unless it fits whole on this one,
% e.g. \keeprubric{14}{achievements} for one about 14 lines long.
\RequirePackage{needspace}
% \Needspace breaks the page outright when the rubric does not fit, leaving no
% penalty behind for longtable to break at after its first heading.
\newcommand{\keeprubric}[2]{\Needspace{#1\baselineskip}\makerubric{#2}}

\defbibheading{subbibliography}{\vskip 6pt{\@subrubricfont\hspace{3pt}#1}\par}

\defbibfilter{booksandchapters}{%
( type=book or type=incollection )
}

\RequirePackage{pgffor}
\newcommand{\mynames}[1]{\def\my@namelist{#1}}
\newtoggle{boldname}
\renewcommand*{\mkbibnamefamily}[1]{%
  \global\togglefalse{boldname}%
  \foreach \my@fname / \my@gname in \my@namelist {%
    \ifboolexpr{ test {\ifdefstrequal{\namepartfamily}{\my@fname}}
                 and
                 test {\ifdefstrequal{\namepartgiven}{\my@gname}}}
      {\global\toggletrue{boldname}}{}%
  }%
  \iftoggle{boldname}{\textbf{#1}}{#1}%
}

\renewcommand*{\mkbibnamegiven}[1]{%
  \global\togglefalse{boldname}%
  \foreach \my@fname / \my@gname in \my@namelist{%
    \ifboolexpr{ test {\ifdefstrequal{\namepartfamily}{\my@fname}}
                 and
                 test {\ifdefstrequal{\namepartgiven}{\my@gname}}}
      {\global\toggletrue{boldname}\breakforeach}{}%
  }%
  \iftoggle{boldname}{\textbf{#1}}{#1}%
}



