\definecolor{CVText}{HTML}{2B3542}
\definecolor{CVMuted}{HTML}{5D6876}
\definecolor{CVAccent}{HTML}{0E7C7B}
\definecolor{CVAccentDark}{HTML}{0A5F5E}
\definecolor{CVAccentLight}{HTML}{3AA9A0}
